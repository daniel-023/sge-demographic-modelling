#!/bin/bash
#PBS -q normal
#PBS -N eval_model
#PBS -l select=1:ngpus=1:ncpus=4:mem=32gb
#PBS -l walltime=04:00:00
#PBS -P <YOUR_PROJECT_CODE>
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
die() { echo "$1" >&2; exit 2; }

USER_ROOT="${USER_ROOT:-/scratch/users/ntu/<YOUR_USER>}"
BASE_ROOT="${BASE_ROOT:-$USER_ROOT/FYP}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$USER_ROOT/micromamba}"
MAMBA="${MAMBA:-$USER_ROOT/bin/micromamba}"
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1

[[ -x "$MAMBA" ]] || die "missing micromamba: $MAMBA"

MODEL_TYPE="${MODEL_TYPE:-lstm}"  # mlp | lstm
TASK="${TASK:-gender}"           # gender | ethnicity | age_bin | age_raw
PART="${PART:-}"
if [[ -n "$PART" ]]; then
  PART_ID="${PART#part_}"
  PART_ID="${PART_ID#part}"
fi
PART_ID="${PART_ID:-2}"
PART="part${PART_ID}"
EMB_TAG="${EMB_TAG:-}"

if [[ -z "$EMB_TAG" ]]; then
  if [[ "$MODEL_TYPE" == "mlp" ]]; then
    EMB_TAG="part${PART_ID}_mlp_full"
  else
    EMB_TAG="part${PART_ID}_cap150"
  fi
fi

EMBEDDING_DIR="${EMBEDDING_DIR:-$BASE_ROOT/results/embeddings/baseplus/${EMB_TAG}}"
METADATA_CSV="${METADATA_CSV:-$BASE_ROOT/data/metadata/cleaned/part${PART_ID}_speakers.csv}"
SPLIT_DIR="${SPLIT_DIR:-$BASE_ROOT/data/splits}"
SPLIT="${SPLIT:-test}"
BATCH_SIZE="${BATCH_SIZE:-64}"
NUM_WORKERS="${NUM_WORKERS:-4}"
OUTPUT_DIR="${OUTPUT_DIR:-$BASE_ROOT/results/evaluation}"
CHECKPOINT="${CHECKPOINT:-$BASE_ROOT/results/${MODEL_TYPE}/${EMB_TAG}/${TASK}/best_${MODEL_TYPE}_${TASK}.pt}"

[[ "$MODEL_TYPE" == "mlp" || "$MODEL_TYPE" == "lstm" ]] || die "invalid MODEL_TYPE: $MODEL_TYPE"

[[ -f "$CHECKPOINT" ]] || die "missing CHECKPOINT: $CHECKPOINT"
[[ -d "$EMBEDDING_DIR" ]] || die "missing EMBEDDING_DIR: $EMBEDDING_DIR"
[[ -f "$METADATA_CSV" ]] || die "missing METADATA_CSV: $METADATA_CSV"
[[ -d "$SPLIT_DIR" ]] || die "missing SPLIT_DIR: $SPLIT_DIR"

CMD=(
  python3 -m scripts.models.evaluate
  --checkpoint "$CHECKPOINT"
  --embedding_dir "$EMBEDDING_DIR"
  --metadata_csv "$METADATA_CSV"
  --split_dir "$SPLIT_DIR"
  --split "$SPLIT"
  --part "$PART"
  --batch_size "$BATCH_SIZE"
  --num_workers "$NUM_WORKERS"
  --output_dir "$OUTPUT_DIR"
)

echo "Running: ${CMD[*]}"
"$MAMBA" run -n fyp "${CMD[@]}"
