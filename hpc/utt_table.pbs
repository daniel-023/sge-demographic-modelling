#!/bin/bash
#PBS -q normal
#PBS -N utt_table
#PBS -l select=1:ncpus=8
#PBS -l walltime=04:00:00
#PBS -P <YOUR_PROJECT_CODE>
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
die() { echo "$1" >&2; exit 2; }

USER_ROOT="${USER_ROOT:-/scratch/users/ntu/<YOUR_USER>}"
BASE_ROOT="${BASE_ROOT:-$USER_ROOT/FYP}"
REPO_ROOT="${REPO_ROOT:-$PBS_O_WORKDIR}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$USER_ROOT/micromamba}"
MAMBA="${MAMBA:-$USER_ROOT/bin/micromamba}"
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1

[[ -x "$MAMBA" ]] || die "missing micromamba: $MAMBA"

SCRIPT_PATH="${SCRIPT_PATH:-$REPO_ROOT/scripts/preprocessing/build_utterance_table.py}"

PARTS="${PARTS:-3}"
AUDIO_ROOT_BASE="${AUDIO_ROOT_BASE:-$BASE_ROOT}"
SPLIT_DIR="${SPLIT_DIR:-$BASE_ROOT/splits}"
OUT_DIR="${OUT_DIR:-$BASE_ROOT/metadata}"
SPEAKER_METADATA_DIR="${SPEAKER_METADATA_DIR:-$BASE_ROOT/metadata/speakers}"
MIN_DURATION_SEC="${MIN_DURATION_SEC:-3.0}"
MAX_DURATION_SEC="${MAX_DURATION_SEC:-15.0}"
MAX_WORKERS="${MAX_WORKERS:-8}"

PART3_TEXTGRID_DIR="${PART3_TEXTGRID_DIR:-$BASE_ROOT/part_3/textgrid/Scripts Separate}"
PART3_SLICE_OUT_DIR="${PART3_SLICE_OUT_DIR:-$BASE_ROOT/part_3/speakers}"

[[ -f "$SCRIPT_PATH" ]] || die "missing script: $SCRIPT_PATH"
[[ -d "$SPLIT_DIR" ]] || die "missing SPLIT_DIR: $SPLIT_DIR"

CMD=(
  python3 "$SCRIPT_PATH"
  --parts "$PARTS"
  --audio_root_base "$AUDIO_ROOT_BASE"
  --split_dir "$SPLIT_DIR"
  --out_dir "$OUT_DIR"
  --speaker_metadata_dir "$SPEAKER_METADATA_DIR"
  --min_duration_sec "$MIN_DURATION_SEC"
  --max_duration_sec "$MAX_DURATION_SEC"
  --max_workers "$MAX_WORKERS"
  --part3_use_textgrid
  --part3_audio_dir "$PART3_AUDIO_DIR"
  --part3_textgrid_dir "$PART3_TEXTGRID_DIR"
  --part3_slice_out_dir "$PART3_SLICE_OUT_DIR"
)

[[ -n "${PART3_AUDIO_DIR:-}" ]] || die "missing PART3_AUDIO_DIR"
[[ -d "$PART3_TEXTGRID_DIR" ]] || die "missing PART3_TEXTGRID_DIR: $PART3_TEXTGRID_DIR"
[[ -d "$PART3_AUDIO_DIR" ]] || die "missing PART3_AUDIO_DIR: $PART3_AUDIO_DIR"

echo "Running: ${CMD[*]}"
"$MAMBA" run -n fyp "${CMD[@]}"
