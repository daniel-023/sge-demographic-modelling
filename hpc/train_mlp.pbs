#!/bin/bash
#PBS -q normal
#PBS -N train_mlp
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=24:00:00
#PBS -P <YOUR_PROJECT_CODE>
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
die() { echo "$1" >&2; exit 2; }

USER_ROOT="${USER_ROOT:-/scratch/users/ntu/<YOUR_USER>}"
BASE_ROOT="${BASE_ROOT:-$USER_ROOT/FYP}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$USER_ROOT/micromamba}"
MAMBA="${MAMBA:-$USER_ROOT/bin/micromamba}"
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1

[[ -x "$MAMBA" ]] || die "missing micromamba: $MAMBA"

PART="${PART:-}"
if [[ -n "$PART" ]]; then
  PART_ID="${PART#part_}"
  PART_ID="${PART_ID#part}"
fi
PART_ID="${PART_ID:-2}"
PART="part${PART_ID}"
TASK="${TASK:-gender}"  # gender | ethnicity | age_bin | age_code | age_raw
EMB_TAG="${EMB_TAG:-part${PART_ID}_mlp_full}"
EMBEDDING_DIR="${EMBEDDING_DIR:-$BASE_ROOT/results/embeddings/baseplus/${EMB_TAG}}"
METADATA_CSV="${METADATA_CSV:-$BASE_ROOT/data/metadata/cleaned/part${PART_ID}_speakers.csv}"
SPLIT_DIR="${SPLIT_DIR:-$BASE_ROOT/data/splits}"
OUTPUT_DIR="${OUTPUT_DIR:-$BASE_ROOT/results/mlp/${EMB_TAG}/${TASK}}"
BATCH_SIZE="${BATCH_SIZE:-64}"
EPOCHS="${EPOCHS:-50}"
LR="${LR:-3e-4}"
NUM_WORKERS="${NUM_WORKERS:-4}"
TEST_SPLIT="${TEST_SPLIT:-test}"
SELECTION_METRIC="${SELECTION_METRIC:-f1_macro}" # accuracy | f1_macro

[[ -d "$EMBEDDING_DIR" ]] || die "missing EMBEDDING_DIR: $EMBEDDING_DIR"
[[ -f "$METADATA_CSV" ]] || die "missing METADATA_CSV: $METADATA_CSV"
[[ -d "$SPLIT_DIR" ]] || die "missing SPLIT_DIR: $SPLIT_DIR"

mkdir -p "$OUTPUT_DIR"

CMD=(
  python3 -m scripts.models.train_mlp
  --task "$TASK"
  --embedding_dir "$EMBEDDING_DIR"
  --metadata_csv "$METADATA_CSV"
  --split_dir "$SPLIT_DIR"
  --batch_size "$BATCH_SIZE"
  --epochs "$EPOCHS"
  --lr "$LR"
  --num_workers "$NUM_WORKERS"
  --selection_metric "$SELECTION_METRIC"
  --output_dir "$OUTPUT_DIR"
  --test_split "$TEST_SPLIT"
  --balanced_sampling
  --class_weighted_loss
  --evaluate
)

echo "Running: ${CMD[*]}"
"$MAMBA" run -n fyp "${CMD[@]}"
