#!/bin/bash
#PBS -q normal
#PBS -N speaker_tsne
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=04:00:00
#PBS -P <YOUR_PROJECT_CODE>
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
die() { echo "$1" >&2; exit 2; }

USER_ROOT="${USER_ROOT:-/scratch/users/ntu/<YOUR_USER>}"
BASE_ROOT="${BASE_ROOT:-$USER_ROOT/FYP}"
REPO_ROOT="${REPO_ROOT:-$PBS_O_WORKDIR}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$USER_ROOT/micromamba}"
MAMBA="${MAMBA:-$USER_ROOT/bin/micromamba}"
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1

[[ -x "$MAMBA" ]] || die "missing micromamba: $MAMBA"

# t-SNE is CPU-only; optionally avoid oversubscription
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

PART_ID="${PART_ID:-1}"
PART_TAG="part${PART_ID}"

EMB_PATH="${EMB_PATH:-$BASE_ROOT/results/analysis/speaker_embeddings/${PART_TAG}/speaker_embeddings.pt}"
OUT_DIR="${OUT_DIR:-$BASE_ROOT/results/analysis/tsne/${PART_TAG}}"

[[ -f "$EMB_PATH" ]] || die "missing EMB_PATH: $EMB_PATH"
mkdir -p "$OUT_DIR"

CMD=(
  python3 "$REPO_ROOT/scripts/analysis/speaker_tsne.py"
  --emb-path "$EMB_PATH"
  --out-dir "$OUT_DIR"
  --perplexity 30
  --learning-rate 200
  --n-iter 1000
  --init pca
  --metric cosine
)

echo "Running: ${CMD[*]}"
"$MAMBA" run -n fyp "${CMD[@]}"
